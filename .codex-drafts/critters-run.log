function buildPebbleshrew(rng: () => number): { group: THREE.Group; parts: CritterParts } {
  const g = new THREE.Group();
  const sandy = jitterColor(0xc9a876, rng, 0.04);
  const sandyDark = jitterColor(0x8f7248, rng, 0.04);

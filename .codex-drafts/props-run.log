+function axisZCylinder(
+  radius: number,
+  depth: number,
+  segments: number,
+  hex: number,
+  x: number,
+  y: number,
+  z: number,
+): THREE.BufferGeometry {
+  const g = new THREE.CylinderGeometry(radius, radius, depth, segments);
+  g.rotateX(Math.PI / 2);
+  g.translate(x, y, z);
+  return colored(g, hex);
+}

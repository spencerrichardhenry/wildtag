  lilypad: buildLilypad,
  mushroom: buildMushroom,
  grasstuft: buildGrasstuft,
  // crystals
  crystal: buildCrystal, // defensive fallback
  crystalA: buildCrystalA,
  crystalB: buildCrystalB,
  crystalC: buildCrystalC,
  // small props / resources

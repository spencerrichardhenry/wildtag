  return merge([
    cyl(0.12, 0.2, 1.4, 5, C.trunk, 0.7),
    cone(1.2, 1.9, 7, C.pineFoliage, 1.1),
    cone(0.9, 1.7, 7, C.pineFoliage, 2.2),
    cone(0.55, 1.4, 7, C.pineFoliage, 3.2),
  ]);
}

